# AegisBay Environment Configuration
# Trusted Mediator & Zero-Trust Enclave Runtime Parameters

# Server Bindings
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cryptographic Keys (Auto-generated if not provided)
# Private Ed25519 seed or PEM path (keep secret!)
AEGISBAY_PRIVATE_KEY_PATH=data/keys/private_key.pem
AEGISBAY_PUBLIC_KEY_PATH=data/keys/public_key.pem

# AI Gateway Orchestrator Integration
# Point to FreeLLMAPI (http://localhost:3001/v1) or OmniRoute (http://localhost:20128/v1)
OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=mock-or-local-token

# Enclave Latency Shaping
BOUNDED_RELEASE_WINDOW_MS=1000
CONSTANT_TIME_RELEASE=true

# Database Path
DATABASE_PATH=data/aegisbay_ledger.db
CHECKPOINT_EXPORT_PATH=data/latest_checkpoint.json
